{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['.next', '.next_4000', '.next_4001'].forEach(d => { try { fs.rmSync(d, { recursive: true, force: true }); } catch (e) {} });\"",
    "predev": "npm run clean",
    "dev": "next dev -p 4000",
    "dev:platform": "npm run clean && next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4000",
    "start:platform": "next start -p 4001"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
